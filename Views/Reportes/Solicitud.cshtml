@model HIS_API.Models3.SolicitudPost

<!DOCTYPE html>
<html lang="es-cl">
<head>
  <title>Reporte de Solicitud</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="@Url.Content("~/css/Solicitud.css")" />
</head>
<body>
  <div class="header">
    <img class="icon-small" src="/img/hsp_logo_coq2.png" alt="Alternate Text" />
    <div class="titulo"><b>Solicitud de Exámenes de<br />Laboratorio N° 100</b></div>
    <img class="icon-medium" src="/img/hps_logo_gob.jpg" alt="Alternate Text" />
  </div>

  <div class="container">
    <div class="info">O R I G E N</div>
    <div class="data">
      <div class="row">
        <div class="column col-6"><b>1.- Servicio de salud</b><br />@Model.ServicioDeSalud</div>
        <div class="column col-6"><b>2.- Establecimiento</b><br />@Model.Establecimiento</div>
      </div>
      <div class="row">
        <div class="column col-6"><b>3.- Unidad Solicitante</b><br />@Model.UnidadSolicitante</div>
        <div class="column col-6"><b>4.- Fecha de Emisión</b><br />@Model.FechaDeEmision</div>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="info">P A C I E N T E</div>
    <div class="data">
      <div class="row">
        <div class="column col-6"><b>5.-Nombre</b><br />@Model.NombrePaciente</div>
        <div class="column col-1_5"><b>6.-Ficha</b><br />@Model.Ficha</div>
        <div class="column col-1_5"><b>7.-C.P.</b><br />@Model.CP</div>
        <div class="column col-3"><b>8.-Cta. Corriente</b><br />@Model.CtaCorriente</div>
      </div>
      <div class="row">
        <div class="column col-3"><b>9.-RUN</b><br />@Model.RUNPaciente</div>
        <div class="column col-3"><b>10.-Sexo</b><br />@Model.Sexo</div>
        <div class="column col-3"><b>11.-Fecha de Nacimiento</b><br />@Model.FechaDeNacimiento</div>
        <div class="column col-3"><b>12.-Edad</b><br />Edad</div>
      </div>
      <div class="row">
        <div class="column col-6"><b>13.-Dirección</b><br />@Model.Direccion</div>
        <div class="column col-6"><b>14.-Ciudad o Comuna</b><br />@Model.Comuna</div>
      </div>
      <div class="row">
        <div class="column col"><b>15.-Teléfonos</b><br />@Model.Telefono</div>
      </div>
      <div class="row">
        <div class="column col"><b>16.-Diagnóstico</b><br />@Model.Diagnostico</div>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="info">E X Á M E N E S</div>
    <div class="data">
      <div class="row">
        <div class="column col"><b>17.-Solicitud</b></div>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="info">P R O F.</div>
    <div class="data">
      <div class="row">
        <div class="column col-4"><b>18.-Nombre</b><br />@Model.NombreProfesional</div>
        <div class="column col-4"><b>19.-RUN</b><br />@Model.RUNProfesional</div>
        <div class="column col-4"><b>20.-Firma</b></div>
      </div>
    </div>
  </div>

</body>
</html>
