@using System.Globalization

@model HIS_API.Models3.SolicitudPost

@{
  int itemNumber = 1;
  var cultura = new CultureInfo("es-ES");
  string fechaFormateada = Model.FechaDeEmision.ToString("dddd d MMMM yyyy, HH:mm", cultura);
  string fechaConMayuscula = cultura.TextInfo.ToTitleCase(fechaFormateada);
}

<!DOCTYPE html>
<html lang="es-cl">
<head>
  <title>Reporte de Solicitud</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href="@Url.Content("~/css/Solicitud.css")" />
</head>
<body>
  <div class="header">
    <img class="icon-small" src="/img/hsp_logo_coq2.png" alt="Alternate Text" />
    <div class="titulo"><b>Solicitud de Exámenes de<br />@Model.Origen N° @Model.SolicitudId</b></div>
    <img class="icon-medium" src="/img/hps_logo_gob.jpg" alt="Alternate Text" />
  </div>

  <div class="container">
    <div class="info">O R I G E N</div>
    <div class="data">
      <div class="row">
        <div class="column col-6"><b>@(itemNumber++) .- Servicio de Salud</b><br />@Model.ServicioDeSalud</div>
        <div class="column col-6"><b>@(itemNumber++) .- Establecimiento</b><br />@Model.Establecimiento</div>
      </div>
      <div class="row">
        <div class="column col-6"><b>@(itemNumber++) .- Unidad Solicitante</b><br />@Model.UnidadSolicitante</div>
        <div class="column col-6"><b>@(itemNumber++) .- Fecha de Emisión</b><br />@fechaConMayuscula</div>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="info">P A C I E N T E</div>
    <div class="data">
      <div class="row">
        <div class="column col-6"><b>@(itemNumber++) .-Nombre</b><br />@Model.NombrePaciente</div>
        <div class="column col-1_5"><b>@(itemNumber++) .-Ficha</b><br />@Model.Ficha</div>
        <div class="column col-1_5"><b>@(itemNumber++) .-C.P.</b><br />@Model.CP</div>
        <div class="column col-3"><b>@(itemNumber++) .-Cta. Corriente</b><br />@Model.CtaCorriente</div>
      </div>
      <div class="row">
        <div class="column col-3"><b>@(itemNumber++) .-RUN</b><br />@Model.RUNPaciente</div>
        <div class="column col-3"><b>@(itemNumber++) .-Sexo</b><br />@Model.Sexo</div>
        <div class="column col-3"><b>@(itemNumber++) .-Fecha de Nacimiento</b><br />@Model.FechaDeNacimiento.ToString("dd/MM/yyyy")</div>
        <div class="column col-3"><b>@(itemNumber++) .-Edad</b><br />@Model.EdadString</div>
      </div>
      <div class="row">
        <div class="column col-6"><b>@(itemNumber++) .-Dirección</b><br />@Model.Direccion</div>
        <div class="column col-3"><b>@(itemNumber++) .-Ciudad o Comuna</b><br />@Model.Comuna</div>
        <div class="column col-3"><b>@(itemNumber++) .-Teléfonos</b><br />@Model.Telefono</div>
      </div>
      <div class="row">
        @if (Model.Origen == "IMAGENOLOGÍA")
        {
          <div class="column col"><b>@(itemNumber++) .-Fundamento</b><br />@Model.Fundamento</div>
        }
        else
        {
          <div class="column col"><b>@(itemNumber++) .-Diagnóstico</b><br />@Model.Diagnostico</div>
        }
      </div>
    </div>
  </div>

  <div class="container">
    <div class="info">E X Á M E N E S</div>
    <div class="data">
      <div class="row">
        <div class="column col">
          <b>@(itemNumber++) .-Solicitud</b><br /><br />
          @if (Model.Origen == "IMAGENOLOGÍA")
          {
            <table class="examenes-table">
              <thead>
                <tr>
                  <th class="left-align">CÓD. FONASA</th>
                  <th class="left-align">TIPO</th>
                  <th class="left-align">NOMBRE</th>
                  <th class="center-align">CONTRASTE</th>
                  <th class="center-align">LATERALIDAD</th>
                </tr>
              </thead>
              <tbody>
                @if (Model.Examenes != null && Model.Examenes.Count > 0)
                {
                  foreach (var examen in Model.Examenes.OrderBy(e => e.ExamenNombre))
                  {
                    <tr>
                      <td class="center-align">@examen.ExamenCodigoFonasa</td>
                      <td class="left-align">@examen.ExamenTipo</td>
                      <td class="left-align">@examen.ExamenNombre</td>
                      <td class="center-align">@examen.Contraste</td>
                      <td class="center-align">@examen.Lateralidad</td>
                    </tr>
                  }
                }
                else
                {
                  <tr>
                    <td colspan="5">No hay exámenes solicitados.</td>
                  </tr>
                }
              </tbody>
            </table>
          }
          else
          {
            <ul>
              @if (Model.Examenes != null && Model.Examenes.Count > 0)
              {
                var examenesAgrupados = Model.Examenes
                .GroupBy(e => e.ExamenTipo)
                .OrderBy(g => g.Key);

                foreach (var grupo in examenesAgrupados)
                {
                  <li><b>@grupo.Key</b></li>
                  foreach (var examen in grupo.OrderBy(e => e.ExamenNombre))
                  {
                    <li style="margin-left: 20px;">@examen.ExamenNombre</li>
                  }
                }
              }
              else
              {
                <li>No hay exámenes solicitados.</li>
              }
            </ul>
          }
        </div>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="info">P R O F.</div>
    <div class="data">
      <div class="row">
        <div class="column col-4"><b>@(itemNumber++) .-Nombre</b><br />@Model.NombreProfesional</div>
        <div class="column col-4"><b>@(itemNumber++) .-RUN</b><br />@Model.RUNProfesional</div>
        <div class="column col-4"><b>@(itemNumber++) .-Firma</b></div>
      </div>
    </div>
  </div>

</body>
</html>
